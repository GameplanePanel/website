{"type": "frame", "id": "e8fTgD", "x": 0, "y": 44308, "name": "Screen/Docs — API & CRDs", "theme": {"semantic": "dark"}, "clip": true, "width": 1440, "height": 900, "fill": "$background/background", "children": [{"id": "oWw6d", "type": "ref", "ref": "K2Rt4H", "height": "fill_container", "name": "DocsSidebar/Expanded", "width": 280}, {"type": "frame", "id": "GVRtd", "name": "Docs Main", "width": "fill_container", "height": "fill_container", "fill": "$background/background", "layout": "vertical", "children": [{"id": "W78sN", "type": "ref", "ref": "SOdlr", "name": "Docs Top Bar", "width": "fill_container", "descendants": {"NImey": {"content": "Extend"}, "ikbi6": {"content": "API & CRDs"}}}, {"type": "frame", "id": "Y0etIh", "name": "Docs Article Body", "clip": true, "width": "fill_container", "height": "fill_container", "gap": 32, "padding": 32, "children": [{"type": "frame", "id": "N5qdg", "name": "Docs Article", "width": 780, "layout": "vertical", "gap": 14, "children": [{"type": "text", "id": "s3zZN", "name": "Article Eyebrow", "fill": "$accent/accent", "content": "REFERENCE", "fontFamily": "JetBrains Mono", "fontSize": 11, "fontWeight": "600", "letterSpacing": 0.8}, {"type": "text", "id": "SwRdE", "name": "Article Title", "fill": "$foreground/foreground", "textGrowth": "fixed-width", "width": "fill_container", "content": "API and CRD reference", "lineHeight": 1.1, "fontFamily": "JetBrains Mono", "fontSize": 30, "fontWeight": "700"}, {"type": "text", "id": "I3xBq", "name": "Article Lead", "fill": "$muted", "textGrowth": "fixed-width", "width": "fill_container", "content": "Automate Gameplane through Kubernetes resources and scoped identities while keeping desired state, observed status, and audit history aligned.", "lineHeight": 1.45, "fontFamily": "Geist", "fontSize": 15, "fontWeight": "normal"}, {"type": "frame", "id": "MFYlH", "name": "Article Metadata", "gap": 8, "alignItems": "center", "children": [{"id": "wxZ3t", "type": "ref", "ref": "NZPtq", "name": "Meta Ch