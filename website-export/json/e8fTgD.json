": [{"type": "text", "id": "vfE3t", "name": "Section Title 2", "fill": "$foreground/foreground", "content": "Status, phases, and conditions", "fontFamily": "JetBrains Mono", "fontSize": 17, "fontWeight": "600"}, {"type": "text", "id": "Dy1jc", "name": "Section Body 2", "fill": "$muted", "textGrowth": "fixed-width", "width": "fill_container", "content": "Observed generation, phase, reason, message, and conditions explain whether the controller has applied the latest intent.", "lineHeight": 1.45, "fontFamily": "Geist", "fontSize": 13, "fontWeight": "normal"}, {"type": "frame", "id": "RHkbr", "name": "Section List 2", "width": "fill_container", "fill": "$surface/surface", "cornerRadius": "$radius/2xl", "stroke": "$border/border", "strokeWidth": 1, "strokeAlignment": "inner", "layout": "vertical", "gap": 5, "padding": [8, 10], "children": [{"type": "frame", "id": "HtVzH", "name": "Section 2 Item 0", "width": "fill_container", "gap": 8, "alignItems": "center", "children": [{"type": "icon", "id": "OtnpV", "name": "Section 2 Item Icon 0", "width": 13, "height": 13, "icon": "check", "library": "lucide", "fill": "$accent/accent"}, {"type": "text", "id": "VSefZ", "name": "Section 2 Item Text 0", "fill": "$default/foreground", "textGrowth": "fixed-width", "width": "fill_container", "content": "Wait for observedGeneration before treating status as current.", "fontFamily": "Geist", "fontSize": 12.5, "fontWeight": "normal"}]}, {"type": "frame", "id": "h1wzgx", "name": "Section 2 Item 1", "width": "fill_container", "gap": 8, "alignItems": "center", "children": [{"type": "icon", "id": "HLG51", "name": "Section 2 Item Icon 1", "width": 13, "height": 13, "icon": "check", "library": "lucide", "fill": "$accent/accent"}, {"type": "text", "id": "b6lQ9", "name": "Section 2 Item Text 1", "fill": "$default/foreground", "textGrowth": "fixed-width", "width": "fill_container", "content": "Use condition type, status, reason, and timestamp in runbooks.", "fontFamily": "Geist", "fontSize": 12.5, 