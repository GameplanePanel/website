{"type": "frame", "id": "p5Gci", "x": 0, "y": 59128, "name": "Screen/Docs — Database Configuration & Lifecycle", "theme": {"semantic": "dark"}, "clip": true, "width": 1440, "height": 900, "fill": "$background/background", "children": [{"id": "SblbP", "type": "ref", "ref": "K2Rt4H", "height": "fill_container", "name": "DocsSidebar/Expanded", "width": 280}, {"type": "frame", "id": "iLeaa", "name": "Docs Main", "width": "fill_container", "height": "fill_container", "fill": "$background/background", "layout": "vertical", "children": [{"id": "mpJgT", "type": "ref", "ref": "SOdlr", "name": "Docs Top Bar", "width": "fill_container", "descendants": {"NImey": {"content": "Platform"}, "ikbi6": {"content": "Database"}}}, {"type": "frame", "id": "a6pOmF", "name": "Docs Article Body", "clip": true, "width": "fill_container", "height": "fill_container", "gap": 32, "padding": 32, "children": [{"type": "frame", "id": "mgxfD", "name": "Docs Article", "width": 780, "layout": "vertical", "gap": 14, "children": [{"type": "text", "id": "r55DX", "name": "Article Eyebrow", "fill": "$accent/accent", "content": "DATA", "fontFamily": "JetBrains Mono", "fontSize": 11, "fontWeight": "600", "letterSpacing": 0.8}, {"type": "text", "id": "z69lHR", "name": "Article Title", "fill": "$foreground/foreground", "textGrowth": "fixed-width", "width": "fill_container", "content": "Database configuration and lifecycle", "lineHeight": 1.1, "fontFamily": "JetBrains Mono", "fontSize": 30, "fontWeight": "700"}, {"type": "text", "id": "tZ8sO", "name": "Article Lead", "fill": "$muted", "textGrowth": "fixed-width", "width": "fill_container", "content": "Select a supported topology, secure its connection, control migrations, and recover platform state independently of game worlds.", "lineHeight": 1.45, "fontFamily": "Geist", "fontSize": 15, "fontWeight": "normal"}, {"type": "frame", "id": "cZCFi", "name": "Article Metadata", "gap": 8, "alignItems": "center", "children": [{"id": "kaitV", "type": "ref", "ref": "NZPt