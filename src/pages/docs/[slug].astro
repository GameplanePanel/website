---
import type { InferGetStaticPropsType } from "astro";
import { render } from "astro:content";
import DocsLayout from "../../layouts/DocsLayout.astro";
import { getOrderedDocs, docHref, sidebarLabel } from "../../lib/docs-nav";

export async function getStaticPaths() {
  const docs = await getOrderedDocs();
  return docs
    .filter((doc) => doc.id !== "dashboard-tour")
    .map((doc) => {
      const index = docs.findIndex((entry) => entry.id === doc.id);
      return {
        params: { slug: doc.id },
        props: {
          doc,
          prev: index > 0 ? docs[index - 1] : null,
          next: index < docs.length - 1 ? docs[index + 1] : null,
        },
      };
    });
}

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { doc, prev, next } = Astro.props;
const { Content, headings } = await render(doc);

// Compute read time if not provided (roughly 200 words per minute)
const computeReadTime = (doc: Props["doc"]) => {
  if (doc.data.readTime) return doc.data.readTime;

  // Get word count from frontmatter (would need to read raw file, so estimate from description)
  const estimatedWords = doc.data.description.split(/\s+/).length + 300; // rough estimate
  const minutes = Math.ceil(estimatedWords / 200);
  return `${minutes} MIN`;
};

const readTime = computeReadTime(doc);
---

<DocsLayout
  title={doc.data.title}
  description={doc.data.description}
  breadcrumb={sidebarLabel(doc)}
  activeId={doc.id}
  eyebrow={doc.data.eyebrow}
  lede={doc.data.description}
  section={doc.data.section}
  group={doc.data.group}
  readTime={readTime}
  covers={doc.data.covers}
  headings={headings}
  prev={prev ? { title: sidebarLabel(prev), href: docHref(prev) } : null}
  next={next ? { title: sidebarLabel(next), href: docHref(next) } : null}
>
  <div class="docs-prose">
    <Content />
  </div>
</DocsLayout>
