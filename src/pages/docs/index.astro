---
import DocsLayout from "../../layouts/DocsLayout.astro";
import Icon from "../../components/Icon.astro";
import { docHref, getOrderedDocs, sidebarLabel } from "../../lib/docs-nav";

const docs = await getOrderedDocs();

// Map docs to categories (16 desktop, 8 mobile) based on section + group
const categoryMap: Record<string, { title: string; description: string; icon: string; groups: string[] }> = {
  // START HERE & INSTALL
  "install-deploy": {
    title: "Install & deploy",
    description: "Helm, prerequisites, ingress, TLS, bootstrap, and upgrades.",
    icon: "rocket",
    groups: ["start-here:*"],
  },
  // START HERE & UI
  "dashboard-create": {
    title: "Dashboard & create",
    description: "Tour the UI and create a server from template to review.",
    icon: "layout-dashboard",
    groups: ["start-here:dashboard-tour", "start-here:create-a-server"],
  },
  // OPERATE - Servers
  "server-operations": {
    title: "Server operations",
    description: "Fleet states, lifecycle, players, ownership, and safe actions.",
    icon: "server",
    groups: ["operate:servers-config"],
  },
  // OPERATE - Console
  "console-logs": {
    title: "Console & logs",
    description: "Events, RCON, live console, container logs, and failed starts.",
    icon: "terminal",
    groups: ["operate:console-logs"],
  },
  // OPERATE - Files
  "files-mods-worlds": {
    title: "Files, mods & worlds",
    description: "Browser editing, uploads, players, mods, modpacks, and safety.",
    icon: "folder",
    groups: ["operate:files-backups:!backup-recovery,backup-destinations,backup-repository"],
  },
  // OPERATE - Backups
  "backups-recovery": {
    title: "Backups & recovery",
    description: "Snapshots, schedules, destinations, retention, and restores.",
    icon: "archive",
    groups: ["operate:files-backups:backup-recovery,backup-destinations,backup-repository"],
  },
  // PLATFORM - Cluster
  "cluster-storage": {
    title: "Cluster & storage",
    description: "Nodes, capacity, placement, StorageClasses, PVCs, and scaling.",
    icon: "boxes",
    groups: ["platform:cluster-storage"],
  },
  // PLATFORM - Users
  "users-access": {
    title: "Users & access",
    description: "Local users, service accounts, roles, permissions, OIDC, and SSO.",
    icon: "users",
    groups: ["platform:users-access"],
  },
  // PLATFORM - Audit
  "audit-observability": {
    title: "Audit & observability",
    description: "Integrity, metrics, system logs, notifications, and admin settings.",
    icon: "activity",
    groups: ["platform:audit-observability"],
  },
  // DEVELOP - Modules
  "modules-sources": {
    title: "Modules & sources",
    description: "Catalog states, registries, signatures, OCI, authoring, and rollback.",
    icon: "package",
    groups: ["develop:modules-sources:!module-authoring"],
  },
  // DEVELOP - API
  "api-gitops": {
    title: "API & GitOps",
    description: "CRDs, status conditions, kubectl, service accounts, and automation.",
    icon: "braces",
    groups: ["develop:api-reference"],
  },
  // REFERENCE - Upgrades & Help
  "upgrades-help": {
    title: "Upgrades & help",
    description: "Migrations, rollback gates, troubleshooting, FAQ, and community.",
    icon: "life-buoy",
    groups: ["reference:upgrades", "reference:troubleshooting", "reference:faq", "reference:community"],
  },
  // PLATFORM/DEVELOP - Production Ops (virtual category)
  "production-operations": {
    title: "Production operations",
    description: "HA, TLS, databases, air-gap, upgrades, rotation, DR, and decommission.",
    icon: "shield",
    groups: ["platform:cluster-storage", "platform:audit-observability"],
  },
  // DEVELOP - Developer Setup
  "developer-setup": {
    title: "Developer setup",
    description: "Repo map, web, API, operator, agent, migrations, tests, CI, and releases.",
    icon: "code",
    groups: ["develop:local-development", "develop:testing-release", "develop:component-guides"],
  },
  // DEVELOP - Module Authoring
  "module-authoring": {
    title: "Module authoring",
    description: "GameTemplate schema, capabilities, actions, testing, publishing, and signing.",
    icon: "puzzle",
    groups: ["develop:modules-sources:module-authoring"],
  },
  // REFERENCE - Deep Reference
  "deep-reference": {
    title: "Deep reference",
    description: "REST, realtime, Helm values, CRDs, permissions, statuses, metrics, and events.",
    icon: "book-open",
    groups: ["develop:api-reference", "reference:releases-roadmap"],
  },
};

// Desktop category order (16 cards)
const desktopCategories = [
  "install-deploy",
  "dashboard-create",
  "server-operations",
  "console-logs",
  "files-mods-worlds",
  "backups-recovery",
  "cluster-storage",
  "users-access",
  "audit-observability",
  "modules-sources",
  "api-gitops",
  "upgrades-help",
  "production-operations",
  "developer-setup",
  "module-authoring",
  "deep-reference",
];

// Mobile category order (8 cards) - curated subset
const mobileCategories = [
  "install-deploy",
  "server-operations",
  "files-mods-worlds",
  "users-access",
  "modules-sources",
  "upgrades-help",
  "developer-setup",
  "deep-reference",
];

// Helper to check if doc matches a category filter
function docMatchesGroup(doc: (typeof docs)[0], groupFilter: string): boolean {
  const [section, groupPart] = groupFilter.split(":");

  if (doc.data.section !== section) return false;

  if (groupPart === "*") return true;

  if (!groupPart) return !doc.data.group;

  // Handle exclusions (!) and specific ids
  if (groupPart.includes(",")) {
    const parts = groupPart.split(",");
    const exclude = parts.filter((p) => p.startsWith("!")).map((p) => p.slice(1));
    const include = parts.filter((p) => !p.startsWith("!"));

    if (exclude.length > 0) {
      return (
        doc.data.group === section && !exclude.some((ex) => doc.id.includes(ex))
      );
    }

    return include.some((id) => doc.id.includes(id));
  }

  if (groupPart.startsWith("!")) {
    const excludeId = groupPart.slice(1);
    return doc.data.group === section && !doc.id.includes(excludeId);
  }

  return doc.data.group === groupPart;
}

// Count docs in each category
function countDocsInCategory(categoryId: string): number {
  const category = categoryMap[categoryId];
  if (!category) return 0;

  const matched = new Set<string>();
  for (const groupFilter of category.groups) {
    docs.forEach((doc) => {
      if (docMatchesGroup(doc, groupFilter)) {
        matched.add(doc.id);
      }
    });
  }

  return matched.size;
}

// Create category cards with counts
const createCategoryCard = (categoryId: string) => {
  const category = categoryMap[categoryId];
  if (!category) return null;

  const count = countDocsInCategory(categoryId);
  const firstDoc = docs.find((doc) => {
    for (const groupFilter of category.groups) {
      if (docMatchesGroup(doc, groupFilter)) return true;
    }
    return false;
  });

  return {
    id: categoryId,
    title: category.title,
    description: category.description,
    icon: category.icon,
    count,
    href: firstDoc ? docHref(firstDoc) : "#",
  };
};

const desktopCards = desktopCategories.map(createCategoryCard).filter((c) => c !== null);
const mobileCards = mobileCategories.map(createCategoryCard).filter((c) => c !== null);

// Calculate total count for the pill
const totalCount = desktopCards.reduce((sum, card) => sum + (card?.count || 0), 0);
const countLabel =
  totalCount >= 80 ? "80+ GUIDES + REFERENCES" : `${totalCount} GUIDES + REFERENCES`;

const searchIndex = docs.map((doc) => ({
  title: doc.data.title,
  description: doc.data.description,
  href: docHref(doc),
  label: sidebarLabel(doc),
}));
const cardHrefs = desktopCards.map((c) => c?.href).filter(Boolean);
---

<DocsLayout
  title="Documentation"
  description="Everything you need to deploy, operate, extend, and contribute to Gameplane."
  breadcrumb="Docs"
  heading="Build, operate, and extend Gameplane"
  lede="Task-focused guides for the complete lifecycle — from the first Helm install to fleet operations, recovery, platform administration, and GitOps."
  activeId="overview"
>
  <div class="flex flex-col gap-6">
    <label
      class="flex w-full max-w-[560px] items-center gap-2.5 rounded-m border border-border bg-card px-4 py-3"
    >
      <Icon name="search" class="h-4 w-4 shrink-0 text-muted-foreground" />
      <input
        id="docs-search"
        class="w-full bg-transparent text-sm text-foreground outline-none placeholder:text-muted-foreground"
        type="search"
        placeholder="Search guides, settings, and CRDs..."
        autocomplete="off"
      />
      <kbd class="rounded border border-border px-1.5 py-0.5 font-primary text-[10px] text-muted-foreground">
        ⌘K
      </kbd>
    </label>

    <div id="docs-search-results" class="hidden flex-col gap-2"></div>

    <div class="flex items-center justify-between gap-4">
      <h2 class="font-primary text-[15px] font-semibold text-foreground">Browse by workflow</h2>
      <span
        class="font-primary text-[10px] font-semibold tracking-wide rounded-full bg-accent/10 px-3 py-1.5 border border-accent/50 text-accent"
      >
        {countLabel}
      </span>
    </div>

    <!-- Desktop: 16-column grid (4 per row) -->
    <div id="docs-cards" class="hidden md:grid gap-3 grid-cols-2 lg:grid-cols-4">
      {
        desktopCards.map((card) => (
          <a
            class="group flex flex-col gap-2 rounded-m border border-border bg-card p-3 hover:border-muted-foreground min-h-28"
            href={card.href}
          >
            <div class="flex items-center justify-between gap-2">
              <div class="flex h-6 w-6 items-center justify-center rounded-[7px] bg-accent/10">
                <Icon name={card.icon} class="h-4 w-4 text-accent" />
              </div>
              <span class="font-primary text-[7.5px] font-semibold text-muted-foreground">
                {card.count} {card.count === 1 ? "guide" : "guides"}
              </span>
            </div>
            <span class="font-primary text-xs font-semibold text-foreground line-clamp-2">
              {card.title}
            </span>
            <span class="text-[11px] leading-tight text-muted-foreground line-clamp-2">
              {card.description}
            </span>
          </a>
        ))
      }
    </div>

    <!-- Mobile: 8-column grid (2 per row) + View all button -->
    <div id="docs-cards-mobile" class="md:hidden flex flex-col gap-3">
      <div class="grid grid-cols-2 gap-3">
        {
          mobileCards.map((card) => (
            <a
              class="group flex flex-col gap-2 rounded-m border border-border bg-card p-3 hover:border-muted-foreground min-h-24"
              href={card.href}
            >
              <div class="flex items-center justify-between gap-2">
                <Icon name={card.icon} class="h-4 w-4 text-accent" />
                <Icon name="arrow-up-right" class="h-3 w-3 text-muted-foreground" />
              </div>
              <span class="font-primary text-xs font-semibold text-foreground line-clamp-1">
                {card.title}
              </span>
              <span class="text-[10px] text-muted-foreground">
                {card.count} {card.count === 1 ? "guide" : "guides"}
              </span>
            </a>
          ))
        }
      </div>
      <a
        href={import.meta.env.BASE_URL + "/docs/"}
        class="flex items-center justify-center gap-2 rounded-m border border-border bg-card px-4 py-2.5 hover:border-muted-foreground font-primary text-sm font-medium text-foreground"
      >
        View all guides and references
        <Icon name="arrow-right" class="h-3.5 w-3.5 text-accent" />
      </a>
    </div>
  </div>
</DocsLayout>

<script is:inline define:vars={{ searchIndex }}>
  const input = document.getElementById("docs-search");
  const results = document.getElementById("docs-search-results");
  const cards = document.getElementById("docs-cards");

  input?.addEventListener("input", () => {
    const query = input.value.trim().toLowerCase();
    if (!query) {
      results.classList.add("hidden");
      results.classList.remove("flex");
      cards.classList.remove("hidden");
      return;
    }
    const matches = searchIndex.filter(
      (doc) =>
        doc.title.toLowerCase().includes(query) ||
        doc.label.toLowerCase().includes(query) ||
        doc.description.toLowerCase().includes(query),
    );
    results.replaceChildren(
      ...matches.map((doc) => {
        const link = document.createElement("a");
        link.href = doc.href;
        link.className =
          "flex flex-col gap-0.5 rounded-m border border-border bg-card px-4 py-3 hover:border-muted-foreground";
        const title = document.createElement("span");
        title.className = "font-primary text-sm font-semibold text-foreground";
        title.textContent = doc.label;
        const desc = document.createElement("span");
        desc.className = "text-[13px] text-muted-foreground";
        desc.textContent = doc.description;
        link.append(title, desc);
        return link;
      }),
    );
    if (matches.length === 0) {
      const empty = document.createElement("span");
      empty.className = "text-[13px] text-muted-foreground";
      empty.textContent = "No pages match your search.";
      results.replaceChildren(empty);
    }
    results.classList.remove("hidden");
    results.classList.add("flex");
    cards.classList.add("hidden");
  });

  window.addEventListener("keydown", (event) => {
    if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === "k") {
      event.preventDefault();
      input?.focus();
    }
  });
</script>
