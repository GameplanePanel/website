---
import iconSvg from "../assets/logo/gameplane-icon.svg";

interface Props {
  size?: "sm" | "md" | "lg";
}

// sm = footer/mobile (24px), md = nav (28px), lg = hero/404 (40px)
const { size = "md" } = Astro.props;
const sizeMap = { sm: 24, md: 28, lg: 40 };
const pixelSize = sizeMap[size || "md"];
---

<img
  src={iconSvg.src}
  alt=""
  width={pixelSize}
  height={pixelSize}
  class="rounded-md"
/>
