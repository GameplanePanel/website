---
import Icon from "../Icon.astro";
import LogoMark from "../LogoMark.astro";
import { SECTIONS, GROUPS, getOrderedDocs, docHref, sidebarLabel } from "../../lib/docs-nav";
import { withBase } from "../../lib/url";

interface Props {
  /** Doc id of the current page ("" on the docs home). */
  activeId?: string;
  /** Render without the logo/back header (mobile disclosure panel). */
  bare?: boolean;
}

const { activeId = "", bare = false } = Astro.props;

const docs = await getOrderedDocs();
const docsByGroup = new Map<string | null, typeof docs>();

// Bucket docs by group (null for no group)
for (const doc of docs) {
  const groupId = doc.data.group ?? null;
  if (!docsByGroup.has(groupId)) {
    docsByGroup.set(groupId, []);
  }
  docsByGroup.get(groupId)!.push(doc);
}

// Find the first doc of each group (hub page)
function getGroupHubDoc(groupId: string) {
  const groupDocs = docsByGroup.get(groupId);
  return groupDocs?.[0];
}

// Check if a doc is active (considering group membership)
function isDocActive(doc: typeof docs[0]) {
  return doc.id === activeId;
}

// Check if any doc in a group is active
function isGroupActive(groupId: string) {
  const groupDocs = docsByGroup.get(groupId) ?? [];
  return groupDocs.some(isDocActive);
}
---

<div class="flex flex-col">
  {
    !bare && (
      <div class="flex flex-col gap-4 border-b border-border p-6">
        <a class="flex items-center gap-2.5" href={withBase("/docs/")}>
          <LogoMark size="md" />
          <span class="font-primary text-base font-semibold text-foreground">gameplane</span>
        </a>
        <a
          class="flex items-center gap-1.5 text-[13px] text-muted-foreground hover:text-foreground"
          href={withBase("/")}
        >
          <Icon name="arrow-left" class="h-3.5 w-3.5" />
          Back to site
        </a>
      </div>
    )
  }
  <nav class="flex flex-col gap-px px-[14px] py-2">
    {SECTIONS.map((section) => {
      const sectionDocs = docs.filter((doc) => doc.data.section === section.id);
      const sectionGroups = GROUPS.filter((g) => g.section === section.id);
      const ungroupedDocs = sectionDocs.filter((doc) => !doc.data.group);

      return (
        <>
          <span class="px-2 pb-px pt-2.5 font-primary text-[9px] font-semibold tracking-[0.7px] text-muted-foreground/70">
            {section.label}
          </span>

          {/* Ungrouped docs (START HERE, CORE CONCEPTS) */}
          {ungroupedDocs.map((doc) => {
            const active = isDocActive(doc);
            const className = `flex h-[27px] items-center gap-2 rounded-md px-[9px] text-[11.5px] ${
              active ? "bg-secondary font-medium text-foreground" : "text-muted-foreground"
            }`;
            return (
              <a
                class={`${className} hover:bg-secondary/60 hover:text-foreground`}
                href={docHref(doc)}
                aria-current={active ? "page" : undefined}
              >
                <Icon name={doc.data.icon} class={`h-3.5 w-3.5 shrink-0 ${active ? "text-primary" : "text-muted-foreground"}`} />
                {sidebarLabel(doc)}
              </a>
            );
          })}

          {/* Groups with child docs */}
          {sectionGroups.map((group) => {
            const hubDoc = getGroupHubDoc(group.id);
            const groupActive = isGroupActive(group.id);
            const groupDocs = docsByGroup.get(group.id) ?? [];
            const childDocs = groupDocs.slice(1); // All except the hub

            return (
              <div>
                {/* Group label/hub link */}
                {hubDoc ? (
                  <a
                    class={`flex h-[27px] items-center gap-2 rounded-md px-[9px] text-[11.5px] hover:bg-secondary/60 hover:text-foreground ${
                      groupActive ? "bg-secondary font-medium text-foreground" : "text-muted-foreground"
                    }`}
                    href={docHref(hubDoc)}
                    aria-current={isDocActive(hubDoc) ? "page" : undefined}
                  >
                    <Icon
                      name={group.icon}
                      class={`h-3.5 w-3.5 shrink-0 ${groupActive ? "text-primary" : "text-muted-foreground"}`}
                    />
                    {group.label}
                  </a>
                ) : (
                  <span class={`flex h-[27px] items-center gap-2 rounded-md px-[9px] text-[11.5px] text-muted-foreground`}>
                    <Icon name={group.icon} class="h-3.5 w-3.5 shrink-0 text-muted-foreground" />
                    {group.label}
                  </span>
                )}

                {/* Child pages (only show when group is active) */}
                {groupActive &&
                  childDocs.map((doc) => {
                    const active = isDocActive(doc);
                    const className = `flex h-[24px] items-center gap-2 rounded-md pl-[32px] pr-[9px] text-[11px] ${
                      active ? "bg-secondary/50 font-medium text-foreground" : "text-muted-foreground"
                    }`;
                    return (
                      <a
                        class={`${className} hover:bg-secondary/60 hover:text-foreground`}
                        href={docHref(doc)}
                        aria-current={active ? "page" : undefined}
                      >
                        {sidebarLabel(doc)}
                      </a>
                    );
                  })}
              </div>
            );
          })}
        </>
      );
    })}
  </nav>
</div>
