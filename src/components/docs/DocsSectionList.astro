---
import Icon from "../Icon.astro";

interface Item {
  icon: string;
  label: string;
  text: string;
}

interface Props {
  items: Item[];
}

const { items } = Astro.props;
---

<div class="rounded-m border border-border bg-card p-5">
  <div class="space-y-3">
    {items.map((item) => (
      <div class="flex gap-3">
        <div class="flex h-8 w-8 shrink-0 items-center justify-center rounded-md bg-secondary">
          <Icon name={item.icon} class="h-4 w-4 text-primary" />
        </div>
        <div class="flex flex-col gap-0.5">
          <span class="text-[13px] font-medium text-foreground">{item.label}</span>
          <span class="text-[12px] text-muted-foreground">{item.text}</span>
        </div>
      </div>
    ))}
  </div>
</div>
