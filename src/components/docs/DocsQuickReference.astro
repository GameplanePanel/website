---
interface Props {
  label: string;
  items: string[];
}

const { label, items } = Astro.props;
---

<div class="rounded-m border border-border bg-card p-5">
  <h3 class="mb-4 font-primary text-[11px] font-semibold tracking-[0.8px] text-primary">
    {label}
  </h3>
  <div class="space-y-2 font-mono text-[13px] text-foreground">
    {items.map((item, idx) => (
      <div>{String(idx + 1).padStart(2, "0")} &nbsp; {item}</div>
    ))}
  </div>
</div>
